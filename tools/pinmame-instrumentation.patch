+static void handle_api_getaway_test(const http_request_t *req, http_response_t *resp)
+{
+    char cmd[32],kind[32],id[32],val[32];
+    char *body;
+    get_query_param(req->query,"cmd",cmd,sizeof(cmd));
+    get_query_param(req->query,"kind",kind,sizeof(kind));
+    get_query_param(req->query,"id",id,sizeof(id));
+    get_query_param(req->query,"val",val,sizeof(val));
+    remote_debug_lock();
+    if (cmd[0] && !remote_debug_is_paused()) {
+        remote_debug_unlock(); respond_error(resp,400,"pause before changing a test fault"); return;
+    }
+    if (!strcmp(cmd,"set")) {
+        if (!id[0] || !val[0] || gwtest_set(kind,parse_int(id),parse_int(val))) {
+            remote_debug_unlock(); respond_error(resp,400,"invalid test fault"); return;
+        }
+    } else if (!strcmp(cmd,"clear")) gwtest_clear();
+    else if (cmd[0]) { remote_debug_unlock(); respond_error(resp,400,"cmd must be set|clear or omitted"); return; }
+    body=gwtest_status();
+    remote_debug_unlock();
+    if (!body) { respond_error(resp,500,"allocation failed"); return; }
+    respond_owned(resp,body,(int)strlen(body),"application/json");
+}
